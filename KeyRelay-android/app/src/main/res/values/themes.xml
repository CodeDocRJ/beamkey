<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeyRelay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/outline</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:textCursorDrawable">@drawable/cursor_emerald</item>
        <item name="android:textColorHighlight">#334EDEA3</item>
    </style>

    <style name="Text" parent="">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="Text.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/outline</item>
    </style>
    <style name="Text.Mono">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/outline</item>
    </style>
    <style name="Text.Code">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Button" parent="">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    <style name="Button.Ghost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="Button.Approve">
        <item name="android:background">@drawable/bg_btn_approve</item>
        <item name="android:textColor">@color/on_secondary</item>
    </style>
    <style name="Button.Deny">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/outline</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
</resources>
